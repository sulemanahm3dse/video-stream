PORT=3000

# Postgres
DATABASE_URL=postgres://video:video@localhost:5432/video

# S3 / MinIO
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=videos
S3_FORCE_PATH_STYLE=true

# Processing
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe
HLS_SEGMENT_SECONDS=6
STORYBOARD_INTERVAL_SECONDS=10
DELETE_ORIGINAL_AFTER_PROCESSING=false
WORKER_POLL_MS=3000
TMP_DIR=./tmp
HLS_PRESET=veryfast
FFMPEG_THREADS=0
STALE_JOB_MINUTES=5
